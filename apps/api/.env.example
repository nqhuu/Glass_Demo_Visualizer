NODE_ENV=development
PORT=3000
API_PREFIX=api

DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=glass_app
DATABASE_PASSWORD=glass_app_password
DATABASE_NAME=glass_demo_visualizer
DATABASE_SYNCHRONIZE=true

JWT_SECRET=replace-with-a-strong-local-secret
JWT_EXPIRES_IN=15m

CORS_ORIGIN=http://localhost:5173
UPLOAD_ROOT=./uploads
EXPORT_ROOT=./exports
UPLOAD_MAX_IMAGE_BYTES=10485760
EXPORT_COPYRIGHT_TEXT=(c) 2026 GlassDemo. All rights reserved.
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX_REQUESTS=10

SEED_ADMIN_NAME=Local Admin
SEED_ADMIN_EMAIL=admin@example.local
SEED_ADMIN_PASSWORD=change-this-local-admin-password
SEED_DEMO_DATA_ENABLED=true
SEED_DEMO_USER_NAME=Demo Consultant
SEED_DEMO_USER_EMAIL=consultant@example.local
SEED_DEMO_USER_PASSWORD=change-this-local-demo-password
